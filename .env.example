SAMPLE_RATE=16000
OUTPUT_DIR=outputs
MEMORY_FILE=outputs/memory.json
STATE_FILE=outputs/emotion_state.json
MAX_HISTORY_TURNS=3

# Recording / VAD
VAD_BACKEND=energy
VAD_THRESHOLD=0.004
FRAME_MS=32
MIN_SPEECH_MS=160
SILENCE_MS=1000
MAX_RECORD_SECONDS=15
PRE_ROLL_MS=400
VAD_CALIBRATION_MS=800
VAD_NOISE_MULTIPLIER=3.0
VAD_RELEASE_RATIO=0.60
VAD_DEBUG=0

# ASR
ASR_BACKEND=mock
# ASR_BACKEND=faster_whisper
ASR_MODEL=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_LANGUAGE=zh
ASR_CPU_THREADS=4
ASR_BEAM_SIZE=1
ASR_VAD_FILTER=1
ASR_MIN_SILENCE_MS=500
ASR_CONDITION_ON_PREVIOUS_TEXT=0

# SER
SER_BACKEND=heuristic
# SER_BACKEND=sensevoice
# SER_MODEL=models/ser/SenseVoiceSmall
SER_DEVICE=cpu
SER_LANGUAGE=zh
SER_FALLBACK_TO_HEURISTIC=1

# LLM
LLM_BACKEND=ollama
LLM_MODEL=qwen3:4b-instruct
LLM_OLLAMA_BASE_URL=http://localhost:11434
# Optional override. Leave unset to derive from LLM_OLLAMA_BASE_URL.
# Uncomment only for proxies, gateways, or non-standard endpoints.
# LLM_OLLAMA_CHAT_URL=http://localhost:11434/api/chat
LLM_LMSTUDIO_BASE_URL=http://localhost:1234
# Optional override. Leave unset to derive from LLM_LMSTUDIO_BASE_URL.
# Uncomment only for proxies, gateways, or non-standard endpoints.
# LLM_LMSTUDIO_CHAT_URL=http://localhost:1234/v1/chat/completions
LLM_FALLBACK_TO_MOCK=0
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=512
LLM_CONTEXT_TOKENS=8192
LLM_TIMEOUT_SECONDS=180

# TTS
TTS_BACKEND=mock
# TTS_BACKEND=piper
TTS_VOICE=zh-CN-XiaoxiaoNeural
# TTS_PIPER_EXE is optional. Leave unset to use the platform default.
# Windows:
# TTS_PIPER_EXE=tools/piper/piper.exe
# Ubuntu:
# TTS_PIPER_EXE=tools/piper/piper
TTS_PIPER_MODEL=models/piper/zh_CN-huayan-medium/your-model.onnx
# TTS_PIPER_CONFIG is optional. By default, Piper tries <TTS_PIPER_MODEL>.json.
# Enable this only when the model config file is not next to the model file.
# TTS_PIPER_CONFIG=models/piper/zh_CN-huayan-medium/your-model.onnx.json
TTS_PIPER_TIMEOUT_SECONDS=60
TTS_PIPER_USE_JSON_INPUT=0
# TTS_PIPER_ESPEAK_DATA=tools/piper/espeak-ng-data
# TTS_PIPER_EXTRA_ARGS=

# Emotion smoothing
EMOTION_SMOOTH_ALPHA=0.35
EMOTION_DECAY_HALF_LIFE_SECONDS=120
EMOTION_MAX_STEP=0.25
