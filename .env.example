SAMPLE_RATE=16000
OUTPUT_DIR=outputs
MEMORY_FILE=outputs/memory.json
STATE_FILE=outputs/emotion_state.json
MAX_HISTORY_TURNS=6

# Recording / VAD
VAD_BACKEND=energy
VAD_THRESHOLD=0.018
FRAME_MS=32
MIN_SPEECH_MS=400
SILENCE_MS=800
MAX_RECORD_SECONDS=8.0
PRE_ROLL_MS=300

# ASR
ASR_BACKEND=mock

# LLM
LLM_BACKEND=ollama
LLM_MODEL=qwen3:4b
LLM_OLLAMA_BASE_URL=http://localhost:11434
LLM_OLLAMA_CHAT_URL=http://localhost:11434/api/chat
LLM_LMSTUDIO_BASE_URL=http://localhost:1234
LLM_LMSTUDIO_CHAT_URL=http://localhost:1234/v1/chat/completions
LLM_FALLBACK_TO_MOCK=0
LLM_THINK=0
LLM_STREAM=0
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=180

# TTS
TTS_BACKEND=mock
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_ASYNC=0

# Emotion smoothing
EMOTION_SMOOTH_ALPHA=0.35

# Serial
SERIAL_PORT=COM3
SERIAL_BAUDRATE=115200
SERIAL_ENABLE=0
