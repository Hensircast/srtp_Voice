SAMPLE_RATE=16000
OUTPUT_DIR=outputs
MEMORY_FILE=outputs/memory.json
STATE_FILE=outputs/emotion_state.json
MAX_HISTORY_TURNS=3

# Recording / VAD
VAD_BACKEND=energy
VAD_THRESHOLD=0.004
FRAME_MS=32
MIN_SPEECH_MS=160
SILENCE_MS=1000
MAX_RECORD_SECONDS=15
PRE_ROLL_MS=400
VAD_CALIBRATION_MS=800
VAD_NOISE_MULTIPLIER=3.0
VAD_RELEASE_RATIO=0.60
VAD_DEBUG=0

# ASR
ASR_BACKEND=mock
# ASR_BACKEND=faster_whisper
ASR_MODEL=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_LANGUAGE=zh
ASR_CPU_THREADS=4
ASR_BEAM_SIZE=1
ASR_VAD_FILTER=1
ASR_MIN_SILENCE_MS=500
ASR_CONDITION_ON_PREVIOUS_TEXT=0

# LLM
LLM_BACKEND=ollama
LLM_MODEL=qwen3:4b-instruct
LLM_OLLAMA_BASE_URL=http://localhost:11434
# Optional override. Leave unset to derive from LLM_OLLAMA_BASE_URL.
# Uncomment only for proxies, gateways, or non-standard endpoints.
# LLM_OLLAMA_CHAT_URL=http://localhost:11434/api/chat
LLM_LMSTUDIO_BASE_URL=http://localhost:1234
# Optional override. Leave unset to derive from LLM_LMSTUDIO_BASE_URL.
# Uncomment only for proxies, gateways, or non-standard endpoints.
# LLM_LMSTUDIO_CHAT_URL=http://localhost:1234/v1/chat/completions
LLM_FALLBACK_TO_MOCK=0
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=512
LLM_CONTEXT_TOKENS=8192
LLM_TIMEOUT_SECONDS=180

# TTS
TTS_BACKEND=mock
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_ASYNC=0

# Emotion smoothing
EMOTION_SMOOTH_ALPHA=0.35

# Serial
SERIAL_PORT=COM3
SERIAL_BAUDRATE=115200
SERIAL_ENABLE=0
